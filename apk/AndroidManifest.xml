<?xml version="1.0" encoding="utf-8"?>
<!--
  PixelSoft para Android.

  El APK es autonomo: lleva el juego entero dentro (HTML, CSS, JS y el cerebro
  simulado) y no necesita ni PC ni conexion. Los empleados piensan con reglas y
  frases escritas a mano, no con un modelo real: un movil no puede mover un
  modelo de 9B.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pixelsoft.juego"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <application
        android:label="@string/nombre_app"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/TemaPixelSoft"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/nombre_app"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
