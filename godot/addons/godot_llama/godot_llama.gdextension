[configuration]
entry_symbol = "godot_llama_library_init"
compatibility_minimum = "4.4"

[libraries]
windows.debug.x86_64 = "res://addons/godot_llama/bin/libgodot_llama.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://addons/godot_llama/bin/libgodot_llama.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://addons/godot_llama/bin/libgodot_llama.android.template_release.arm64.so"
android.release.arm64 = "res://addons/godot_llama/bin/libgodot_llama.android.template_release.arm64.so"

[dependencies]
windows.x86_64 = {"res://addons/godot_llama/bin/llama.dll": "", "res://addons/godot_llama/bin/ggml.dll": "", "res://addons/godot_llama/bin/ggml-base.dll": "", "res://addons/godot_llama/bin/ggml-cpu.dll": ""}
