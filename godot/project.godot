; PixelSoft 2 · Godot 4
config_version=5

[application]
config/name="PixelSoft"
config/version="2.1.0"
run/main_scene="res://principal.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icono.png"
config/windows_native_icon="res://icono.ico"
boot_splash/bg_color=Color(0.035, 0.063, 0.125, 1)
boot_splash/image="res://assets/logo/splash.png"
run/low_processor_mode=false
config/quit_on_go_back=false

[autoload]
Llm="*res://scripts/llm.gd"
MotorIA="*res://scripts/motor_ia.gd"
Dlc="*res://scripts/dlc.gd"
Mods="*res://scripts/mods.gd"
Juego="*res://scripts/juego.gd"
Actualizador="*res://scripts/actualizador.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fuentes/Nunito.ttf"
theme/default_font_antialiasing=1
theme/default_font_hinting=1
theme/default_font_subpixel_positioning=1
theme/default_font_multichannel_signed_distance_field=false

[input_devices]
pointing/emulate_touch_from_mouse=false

[rendering]
textures/default_filters/anisotropic_filtering_level=3
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
